<div class="mx-auto">
    <div style="display: flex; justify-content: space-between;">
      <div><%= render 'search/form' %></div>
      <div class="date-text" ><%= @date %></div>
    </div>
  <div class="home-container">
    <div class="location-container">
      <span class="home-location"><%=@data["name"] %></span>
    </div>
    <div class="current-temp-container"><h1 class="home-current-temp"><%=@temp %>&deg;c</h1></div>
    <div class="home-container3">
      <div class="weather-icon">
        <%= image_tag 'Coverageicon.svg' %>
      </div>
      <div class="weather-icon">
        <%= image_tag 'Humidityicon.svg' %>
      </div>
      <div class="weather-icon">
      <% case @data["weather"][0]["icon"].slice(0..1) %>
        <% when "01" %>
          <%= image_tag 'Sunicon.svg' %>
        <% when "02" %>
          <%= image_tag 'Partlycloudyicon.svg' %>
        <% when "03" %>
          <%= image_tag 'Cloudyicon.svg' %>
        <% when "04" %>
          <%= image_tag 'Cloudyicon.svg' %>
        <% when "09" %>
          <%= image_tag 'Rainicon.svg' %>
        <% when "10" %>
          <%= image_tag 'Rainicon.svg' %>
        <% when "11" %>
          <%= image_tag 'Thundericon.svg' %>
        <% when "13" %>
          <%= image_tag 'Snowcloudicon.svg' %>
        <% when "50" %>
          <%= image_tag 'Fogicon.svg' %>
      <% end %>
      </div>
      <div class="weather-icon">
        <%= image_tag 'Windicon.svg' %>
      </div>
      <div class="weather-icon">
        <%= image_tag 'Raindropicon.svg' %>
      </div>
    </div>
    <div class="home-container4">
      <div class="weather-data">
          <span style="font-weight: bold;" >Cloud Coverage</span>
          <span><%=@data["clouds"]["all"]%> %</span>
      </div>
      <div class="weather-data">
        <span style="font-weight: bold;" >Humidity</span>
        <span><%=@data["main"]["humidity"]%> %</span>
      </div>
      <div class="home-conditions-data">
        <div class="home-description">
          <span>
            <span style="font-weight: bold;" ><%=@data["weather"][0]["description"]%></span>
            <br />
          </span>
        </div>
        <div class="home-container5">
          <div class="home-container6">
            <span class="temp-low">L: <%=@temp_low %></span>
          </div>
          <div class="home-container7">
            <span class="temp-high">H: <%=@temp_high %></span>
          </div>
        </div>
      </div>
      <div class="weather-data">
        <span style="font-weight: bold;" >Wind Speed</span>
        <span><%=@wind_speed %>kph</span>
      </div>
      <div class="weather-data">
        <span style="font-weight: bold;">Precipitation</span>
        <span class="text-center"><%=@rain%> mm</span>
      </div>
    </div>
  </div>
</div>